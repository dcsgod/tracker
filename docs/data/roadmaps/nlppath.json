        { "id": "crf", "title": "Conditional Random Fields (CRF)", "papers": ["Lafferty et al. - CRF (2001)"] },
        { "id": "tfidf-bm25", "title": "TF-IDF, BM25 — Information Retrieval Foundations", "papers": [] },
        { "id": "lda", "title": "Latent Dirichlet Allocation (LDA) — Topic Modeling", "papers": ["Blei et al. - LDA (2003)"] }
      ]
    },
    {
      "id": "phase-04",
      "title": "Word Embeddings",
      "priority": "must",
      "topics": [
