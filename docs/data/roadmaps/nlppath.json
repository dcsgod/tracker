        { "id": "nlp-linear-algebra", "title": "Linear Algebra — Embeddings, SVD, PCA for NLP", "papers": [] },
        { "id": "nlp-probability", "title": "Probability & Statistics for Language Models", "papers": [] },
        { "id": "nlp-information-theory", "title": "Information Theory — Entropy, Perplexity, Mutual Information in NLP", "papers": ["Shannon - A Mathematical Theory of Communication (1948)"] }
      ]
    },
    {
      "id": "phase-02",
      "title": "NLP Fundamentals",
      "priority": "must",
      "topics": [
        { "id": "tokenization", "title": "Tokenization — BPE, WordPiece, SentencePiece, Tiktoken", "papers": ["Sennrich et al. - BPE for NMT (2016)"] },
        { "id": "pos-tagging", "title": "POS Tagging & Morphological Analysis", "papers": [] },
        { "id": "ner", "title": "Named Entity Recognition (NER) — CRF, BiLSTM-CRF", "papers": [] },
        { "id": "parsing", "title": "Parsing — Constituency, Dependency, CCG", "papers": [] },
        { "id": "text-classification", "title": "Text Classification — Naive Bayes, Logistic Regression baselines", "papers": [] }
      ]
    },
    {
      "id": "phase-03",
      "title": "Classical NLP",
      "priority": "must",
      "topics": [
        { "id": "ngrams", "title": "N-gram Language Models — Smoothing, Kneser-Ney", "papers": [] },
