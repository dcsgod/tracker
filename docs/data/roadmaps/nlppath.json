        { "id": "attention-mechanism", "title": "Attention Mechanism — Luong, Bahdanau", "papers": ["Bahdanau et al. - Neural Machine Translation with Attention (2014)"] },
        { "id": "copy-mechanism", "title": "Copy Mechanism & Pointer Networks", "papers": ["Vinyals et al. - Pointer Networks (2015)"] }
      ]
    },
    {
      "id": "phase-06",
