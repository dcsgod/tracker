      "title": "LLMs & Pre-training",
      "priority": "must",
      "topics": [
        { "id": "scaling-laws-nlp", "title": "Scaling Laws — Kaplan, Chinchilla, Compute-Optimal Training", "papers": ["Kaplan et al. - Scaling Laws (2020)", "Hoffmann et al. - Chinchilla (2022)"] },
        { "id": "llama-family", "title": "LLaMA Family — LLaMA 1/2/3, Mistral, Gemma", "papers": ["Touvron et al. - LLaMA 2 (2023)"] },
        { "id": "zero-distributed", "title": "ZeRO & Distributed Training — FSDP, Megatron-LM, DeepSpeed", "papers": ["Rajbhandari et al. - ZeRO (2020)"] },
        { "id": "data-curation", "title": "Data Curation for LLMs — FineWeb, Dolma, Quality Filtering", "papers": ["Penedo et al. - FineWeb (2024)"] }
      ]
    },
    {
      "id": "phase-08",
      "title": "Fine-tuning & Alignment",
      "priority": "must",
      "topics": [
        { "id": "lora-qlora", "title": "LoRA & QLoRA — Parameter-Efficient Fine-tuning", "papers": ["Hu et al. - LoRA (2021)", "Dettmers et al. - QLoRA (2023)"] },
        { "id": "rlhf", "title": "RLHF — Reward Modeling, PPO-based Alignment", "papers": ["Ouyang et al. - InstructGPT (2022)"] },
        { "id": "dpo", "title": "DPO & Variants — Direct Preference Optimization", "papers": ["Rafailov et al. - DPO (2023)"] },
        { "id": "constitutional-ai", "title": "Constitutional AI & Self-Critique", "papers": ["Bai et al. - Constitutional AI (2022)"] },
        { "id": "orpo", "title": "ORPO, GRPO, SimPO — Modern Alignment Methods", "papers": ["Hong et al. - ORPO (2024)"] },
        { "id": "instruction-tuning", "title": "Instruction Tuning — FLAN, Alpaca, WizardLM", "papers": ["Wei et al. - FLAN (2021)"] }
      ]
    },
    {
      "id": "phase-09",
      "title": "RL for LLMs",
      "priority": "must",
      "topics": [
        { "id": "ppo-llms", "title": "PPO for LLMs — KL Penalty, Value Model, GAE", "papers": ["Schulman et al. - PPO (2017)"] },
        { "id": "grpo", "title": "GRPO — Group Relative Policy Optimization", "papers": ["Shao et al. - DeepSeekMath GRPO (2024)"] },
        { "id": "reward-hacking", "title": "Reward Hacking & Overoptimization", "papers": ["Gao et al. - Scaling Laws for Reward Model Overoptimization (2022)"] },
        { "id": "online-vs-offline-rl", "title": "Online vs Offline RL for LLMs — RAFT, RLOO", "papers": [] }
      ]
    },
    {
      "id": "phase-10",
      "title": "Reasoning & Inference",
      "priority": "must",
      "topics": [
        { "id": "chain-of-thought", "title": "Chain-of-Thought — Standard, Zero-Shot, Self-Consistency", "papers": ["Wei et al. - CoT (2022)", "Wang et al. - Self-Consistency (2022)"] },
        { "id": "tree-of-thought", "title": "Tree-of-Thought & Graph-of-Thought", "papers": ["Yao et al. - Tree of Thoughts (2023)"] },
        { "id": "prm-orm", "title": "Process & Outcome Reward Models — PRM800K, OmegaPRM", "papers": ["Lightman et al. - Let's Verify Step by Step (2023)"] },
        { "id": "rag", "title": "RAG — Retrieval-Augmented Generation, FAISS, Reranking", "papers": ["Lewis et al. - RAG (2020)"] },
        { "id": "deepseek-r1", "title": "DeepSeek-R1 & Test-Time Compute Scaling", "papers": ["Guo et al. - DeepSeek-R1 (2025)"] },
        { "id": "o1-reasoning", "title": "o1 & System 2 Reasoning — Long CoT, MCTS, Best-of-N", "papers": [] }
      ]
    }
  ]
