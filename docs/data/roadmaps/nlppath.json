        { "id": "fasttext", "title": "FastText — Subword Embeddings", "papers": ["Bojanowski et al. - FastText (2017)"] },
        { "id": "elmo", "title": "ELMo — Contextual Embeddings from Language Models", "papers": ["Peters et al. - ELMo (2018)"] }
      ]
    },
    {
      "id": "phase-05",
      "title": "Neural NLP & Seq2Seq",
      "priority": "must",
      "topics": [
